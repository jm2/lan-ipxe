## High-signal audit rules for a developer workstation, installed as
## /etc/audit/rules.d/50-workstation.rules by setup-{fedora,arch}-workstation.sh.
## Style and several rules follow the audit package's own samples under
## /usr/share/audit-rules (10-base-config.rules, 11-loginuid.rules,
## 30-stig.rules, 43-module-load.rules). Deliberately NOT monitored:
##   * every execve (30-* syscall rules): far too noisy and slow for a
##     developer workstation that compiles and runs containers all day;
##   * package-owned file churn: rpm -Va / pacman -Qkk verify those trees
##     (see also the AIDE config, which scopes itself the same way).
## Keys are chosen so a Wazuh agent can consume /var/log/audit/audit.log
## (log_format=audit) with straightforward key-based decoders.
## File and directory watches use the syscall-rule form (-F path= for files,
## -F dir= for whole subtrees) with an explicit arch, mirroring the audit
## package's own samples: old-style -w watches match every syscall and
## auditctl warns that they are slower. b32 rules never match on aarch64 but
## load fine there.

## Baseline from 10-base-config.rules: roomy backlog. augenrules builds one
## ruleset from every rules.d file, so this file must not carry the sample's
## -D: a flush here would wipe the rules contributed by lexically earlier
## rules.d files on every load.
-b 8192
-f 1
--backlog_wait_time 60000

## From 11-loginuid.rules: make the loginuid immutable once set, closing
## a trivial cover-its-tracks trick for an intruder with root.
--loginuid-immutable

## Identity and authentication files (30-stig.rules "identity" watches).
-a always,exit -F arch=b32 -F path=/etc/passwd -F perm=wa -F key=identity
-a always,exit -F arch=b64 -F path=/etc/passwd -F perm=wa -F key=identity
-a always,exit -F arch=b32 -F path=/etc/group -F perm=wa -F key=identity
-a always,exit -F arch=b64 -F path=/etc/group -F perm=wa -F key=identity
-a always,exit -F arch=b32 -F path=/etc/shadow -F perm=wa -F key=identity
-a always,exit -F arch=b64 -F path=/etc/shadow -F perm=wa -F key=identity
-a always,exit -F arch=b32 -F path=/etc/gshadow -F perm=wa -F key=identity
-a always,exit -F arch=b64 -F path=/etc/gshadow -F perm=wa -F key=identity
-a always,exit -F arch=b32 -F path=/etc/opasswd -F perm=wa -F key=identity
-a always,exit -F arch=b64 -F path=/etc/opasswd -F perm=wa -F key=identity
-a always,exit -F arch=b32 -F path=/etc/nsswitch.conf -F perm=wa -F key=identity
-a always,exit -F arch=b64 -F path=/etc/nsswitch.conf -F perm=wa -F key=identity
-a always,exit -F arch=b32 -F path=/etc/sudoers -F perm=wa -F key=sudoers
-a always,exit -F arch=b64 -F path=/etc/sudoers -F perm=wa -F key=sudoers
-a always,exit -F arch=b32 -F dir=/etc/sudoers.d -F perm=wa -F key=sudoers
-a always,exit -F arch=b64 -F dir=/etc/sudoers.d -F perm=wa -F key=sudoers
-a always,exit -F arch=b32 -F dir=/etc/pam.d -F perm=wa -F key=pam
-a always,exit -F arch=b64 -F dir=/etc/pam.d -F perm=wa -F key=pam
-a always,exit -F arch=b32 -F dir=/etc/security -F perm=wa -F key=pam
-a always,exit -F arch=b64 -F dir=/etc/security -F perm=wa -F key=pam

## SSH daemon configuration.
-a always,exit -F arch=b32 -F path=/etc/ssh/sshd_config -F perm=wa -F key=sshd_config
-a always,exit -F arch=b64 -F path=/etc/ssh/sshd_config -F perm=wa -F key=sshd_config
-a always,exit -F arch=b32 -F dir=/etc/ssh/sshd_config.d -F perm=wa -F key=sshd_config
-a always,exit -F arch=b64 -F dir=/etc/ssh/sshd_config.d -F perm=wa -F key=sshd_config

## Persistence vectors reachable without replacing package-owned files:
## local systemd units, cron, and system-wide shell initialization. dir=
## rules cover the whole subtree below the directory.
-a always,exit -F arch=b32 -F dir=/etc/systemd/system -F perm=wa -F key=systemd_unit
-a always,exit -F arch=b64 -F dir=/etc/systemd/system -F perm=wa -F key=systemd_unit
-a always,exit -F arch=b32 -F dir=/etc/cron.d -F perm=wa -F key=cron
-a always,exit -F arch=b64 -F dir=/etc/cron.d -F perm=wa -F key=cron
-a always,exit -F arch=b32 -F dir=/etc/cron.hourly -F perm=wa -F key=cron
-a always,exit -F arch=b64 -F dir=/etc/cron.hourly -F perm=wa -F key=cron
-a always,exit -F arch=b32 -F dir=/etc/cron.daily -F perm=wa -F key=cron
-a always,exit -F arch=b64 -F dir=/etc/cron.daily -F perm=wa -F key=cron
-a always,exit -F arch=b32 -F dir=/etc/cron.weekly -F perm=wa -F key=cron
-a always,exit -F arch=b64 -F dir=/etc/cron.weekly -F perm=wa -F key=cron
-a always,exit -F arch=b32 -F dir=/etc/cron.monthly -F perm=wa -F key=cron
-a always,exit -F arch=b64 -F dir=/etc/cron.monthly -F perm=wa -F key=cron
-a always,exit -F arch=b32 -F path=/etc/crontab -F perm=wa -F key=cron
-a always,exit -F arch=b64 -F path=/etc/crontab -F perm=wa -F key=cron
-a always,exit -F arch=b32 -F path=/etc/profile -F perm=wa -F key=shell_rc
-a always,exit -F arch=b64 -F path=/etc/profile -F perm=wa -F key=shell_rc
-a always,exit -F arch=b32 -F dir=/etc/profile.d -F perm=wa -F key=shell_rc
-a always,exit -F arch=b64 -F dir=/etc/profile.d -F perm=wa -F key=shell_rc
-a always,exit -F arch=b32 -F path=/etc/bashrc -F perm=wa -F key=shell_rc
-a always,exit -F arch=b64 -F path=/etc/bashrc -F perm=wa -F key=shell_rc
-a always,exit -F arch=b32 -F path=/etc/bash.bashrc -F perm=wa -F key=shell_rc
-a always,exit -F arch=b64 -F path=/etc/bash.bashrc -F perm=wa -F key=shell_rc

## Kernel module loading (43-module-load.rules). b32 rules never match on
## aarch64 but load fine there; keeping both mirrors the shipped sample.
-a always,exit -F arch=b32 -S init_module,finit_module -k modules
-a always,exit -F arch=b64 -S init_module,finit_module -k modules
-a always,exit -F arch=b32 -S delete_module -k modules
-a always,exit -F arch=b64 -S delete_module -k modules

## Time changes (30-stig.rules time-change). A silent clock change defeats
## log correlation and TLS.
-a always,exit -F arch=b32 -S adjtimex,settimeofday -k time-change
-a always,exit -F arch=b64 -S adjtimex,settimeofday -k time-change
-a always,exit -F arch=b32 -S clock_settime -F a0=0x0 -k time-change
-a always,exit -F arch=b64 -S clock_settime -F a0=0x0 -k time-change
-a always,exit -F arch=b32 -F path=/etc/localtime -F perm=wa -F key=time-change
-a always,exit -F arch=b64 -F path=/etc/localtime -F perm=wa -F key=time-change

## Mounts: mounting another filesystem over a watched path (e.g. /etc) is a
## classic integrity-bypass.
-a always,exit -F arch=b32 -S mount -k mounts
-a always,exit -F arch=b64 -S mount -k mounts

## Auditd's own configuration. The one-shot events from augenrules --load
## writing rules.d are expected when the setup script applies changes.
-a always,exit -F arch=b32 -F path=/etc/audit/auditd.conf -F perm=wa -F key=auditd_config
-a always,exit -F arch=b64 -F path=/etc/audit/auditd.conf -F perm=wa -F key=auditd_config
-a always,exit -F arch=b32 -F dir=/etc/audit/rules.d -F perm=wa -F key=auditd_config
-a always,exit -F arch=b64 -F dir=/etc/audit/rules.d -F perm=wa -F key=auditd_config
